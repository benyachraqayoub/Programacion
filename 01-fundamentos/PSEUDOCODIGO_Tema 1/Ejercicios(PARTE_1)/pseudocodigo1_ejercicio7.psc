Algoritmo pseudocodigo1_ejercicio7
	cant_horas <- 0
	precio_horas <- 0
	nombre <-""
	Escribir  "introduce la cantidad de horas que has trabajado"
	leer cant_horas
	Escribir "introduce el precio de cada hora"
	leer precio_horas
	Escribir "¿Cómo te llamas?"
	leer nombre
	
	salario = cant_horas * precio_horas
	
	Escribir nombre + " te tienen que pagar"
	Escribir  salario
	
FinAlgoritmo
